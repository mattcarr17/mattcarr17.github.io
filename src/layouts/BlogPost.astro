---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { SITE_TITLE } from '../consts';
import { longDate } from '../lib/posts';
import Page from './Page.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, category, pubDate, updatedDate, heroImage } = Astro.props;
---

<Page title={`${title} — ${SITE_TITLE}`} description={description}>
	<article>
		<header class="row post-head">
			<div class="label meta">
				<time datetime={pubDate.toISOString()}>{longDate(pubDate)}</time>
				<span class="accent">{category}</span>
				{
					updatedDate && (
						<span>
							Rev. <time datetime={updatedDate.toISOString()}>{longDate(updatedDate)}</time>
						</span>
					)
				}
			</div>
			<div class="titles">
				<h1 class="page-title">{title}</h1>
				<p class="lede">{description}</p>
			</div>
		</header>

		{
			heroImage && (
				<div class="row hero-row">
					<div />
					<Image class="hero" width={1020} height={510} src={heroImage} alt="" />
				</div>
			)
		}

		<div class="row ruled body">
			<div class="label"><a href="/writing">← Writing</a></div>
			<div class="prose">
				<slot />
			</div>
		</div>
	</article>
</Page>

<style>
	.post-head {
		padding: 64px 0 40px;
	}
	.meta {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding-top: 12px;
	}
	.meta .accent {
		color: var(--accent);
		font-size: 11px;
		letter-spacing: 0.06em;
	}
	.titles {
		display: flex;
		flex-direction: column;
		gap: 14px;
		max-width: 680px;
	}
	.row.hero-row {
		border-top: 0;
	}
	.hero {
		display: block;
		width: 100%;
		max-width: 680px;
		height: auto;
		margin-bottom: 40px;
		border: 1px solid var(--card-border);
	}
	.body {
		padding-top: 32px;
	}
	.body .label a {
		color: var(--muted);
		text-decoration: none;
		text-transform: none;
	}
	.body .label a:hover {
		color: var(--accent);
	}
	@media (max-width: 720px) {
		.meta {
			flex-direction: row;
			flex-wrap: wrap;
			gap: 4px 12px;
		}
		.body .label {
			display: none;
		}
	}
</style>
