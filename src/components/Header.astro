---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="wrap site-header">
	<a class="brand" href="/">{SITE_TITLE}</a>
	<nav aria-label="Primary">
		<HeaderLink href="/writing">Writing</HeaderLink>
		<HeaderLink href="/projects">Projects</HeaderLink>
		<HeaderLink href="/notebook">Notebook</HeaderLink>
		<HeaderLink href="/about">About</HeaderLink>
	</nav>
</header>

<style>
	.site-header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 8px 32px;
		padding-top: 28px;
		padding-bottom: 14px;
		/* Rule spans the content width, not the padding. */
		background: linear-gradient(var(--ink), var(--ink)) no-repeat bottom / calc(100% - 48px) 1.5px;
	}
	.brand {
		display: flex;
		align-items: center;
		min-height: 44px;
		color: var(--ink);
		text-decoration: none;
		font-size: 26px;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0 24px;
		font-family: var(--mono);
		font-size: 13px;
	}
</style>
