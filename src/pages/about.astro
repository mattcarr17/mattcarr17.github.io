---
import { CONTACT, SITE_TITLE } from '../consts';
import Page from '../layouts/Page.astro';

const links = [
	CONTACT.email && { href: `mailto:${CONTACT.email}`, text: CONTACT.email },
	CONTACT.x && { href: `https://x.com/${CONTACT.x}`, text: `X · @${CONTACT.x}` },
	CONTACT.github && { href: `https://github.com/${CONTACT.github}`, text: `GitHub · ${CONTACT.github}` },
].filter(Boolean) as { href: string; text: string }[];
---

<Page title={`About — ${SITE_TITLE}`} description="Applied math at CU Boulder, Muay Thai, guitar, and AI.">
	<section class="row head">
		<div class="label accent">§ About</div>
		<h1 class="page-title">About</h1>
	</section>

	<section class="row block">
		<div class="label">Background</div>
		<div class="text">
			<p>
				I’m an applied math student at CU Boulder, with engineering coursework across physics,
				electrical engineering, and computer science. Before coming back to school I taught data
				science and coached high school lacrosse, after playing it as a faceoff specialist and
				two-time All-American.
			</p>
			<p>
				I train Muay Thai and boxing, take on one Misogi a year (this year, 500 pull-ups), and play
				guitar. I’m here to understand the technologies reshaping the world, AI especially, and to be
				part of the work around them.
			</p>
		</div>
	</section>

	{
		links.length > 0 && (
			<section class="row block contact">
				<div class="label">Contact</div>
				<div class="links">
					{links.map((l) => (
						<a href={l.href}>{l.text}</a>
					))}
				</div>
			</section>
		)
	}
</Page>

<style>
	.head {
		padding: 64px 0 40px;
	}
	.head .label {
		padding-top: 12px;
	}
	.block {
		padding: 28px 0;
	}
	.block:last-child {
		border-bottom: 1px solid var(--rule);
	}
	.text {
		display: flex;
		flex-direction: column;
		gap: 14px;
		max-width: 660px;
	}
	.text p {
		margin: 0;
		font-size: 19px;
		line-height: 1.65;
	}
	.contact .label {
		padding-top: 14px;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 28px;
		font-family: var(--mono);
		font-size: 14px;
	}
	.links a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
	}
	@media (max-width: 720px) {
		.head {
			padding: 48px 0 32px;
		}
		.head .label,
		.contact .label {
			padding-top: 0;
		}
	}
</style>
