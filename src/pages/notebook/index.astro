---
import { SITE_TITLE } from '../../consts';
import Page from '../../layouts/Page.astro';
import { getNotes, longDate, noteUrl } from '../../lib/posts';

const notes = await getNotes();
---

<Page title={`Notebook — ${SITE_TITLE}`} description="Working notes, scratch thoughts, and things I'm figuring out.">
	<section class="row head">
		<div class="label accent">§ Notebook</div>
		<div class="head-body">
			<h1 class="page-title">Notebook</h1>
			<p class="lede">Working notes, scratch thoughts, and things I'm figuring out. Newest first.</p>
		</div>
	</section>

	{
		notes.length === 0 ? (
			<section class="row empty">
				<div />
				<p>Nothing here yet — check back soon.</p>
			</section>
		) : (
			<ol class="entries">
				{notes.map((note) => (
					<li>
						<a class="row entry" href={noteUrl(note.id)}>
							<div class="meta">
								<time datetime={note.data.date.toISOString()}>{longDate(note.data.date)}</time>
							</div>
							<div class="text">
								<span class="title">{note.data.title}</span>
								{note.data.tags.length > 0 && (
									<span class="tags">
										{note.data.tags.map((t) => (
											<span class="tag">#{t}</span>
										))}
									</span>
								)}
							</div>
						</a>
					</li>
				))}
			</ol>
		)
	}
</Page>

<style>
	.head {
		padding: 64px 0 40px;
	}
	.head .label {
		padding-top: 12px;
	}
	.head-body {
		display: flex;
		flex-direction: column;
		gap: 12px;
		max-width: 640px;
	}
	.empty {
		padding: 28px 0;
		border-bottom: 1px solid var(--rule);
	}
	.empty p {
		margin: 0;
		font-size: 19px;
		line-height: 1.65;
		color: var(--ink-soft);
	}
	.entries {
		list-style: none;
		margin: 0;
		padding: 0;
		border-bottom: 1px solid var(--rule);
	}
	.entry {
		padding: 24px 0;
		border-top: 1px solid var(--rule);
		color: var(--ink);
		text-decoration: none;
	}
	.entry:hover .title {
		color: var(--accent);
	}
	.meta {
		padding-top: 6px;
		font-family: var(--mono);
		font-size: 12px;
		color: var(--muted);
	}
	.text {
		display: flex;
		flex-direction: column;
		gap: 8px;
		max-width: 680px;
	}
	.title {
		font-size: 26px;
		line-height: 1.25;
		font-weight: 500;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 14px;
		font-family: var(--mono);
		font-size: 12px;
		color: var(--accent);
	}
	@media (max-width: 720px) {
		.head {
			padding: 48px 0 32px;
		}
		.empty > div:empty {
			display: none;
		}
		.meta {
			padding-top: 0;
		}
		.title {
			font-size: 22px;
		}
	}
</style>
